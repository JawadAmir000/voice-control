{
  "name": "voice-control",
  "version": "0.1.0",
  "description": "Control your Windows PC by voice, with Claude as the brain",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . && electron .",
    "start": "electron .",
    "models": "node scripts/download-models.mjs",
    "test": "vitest run",
    "try": "tsc -p . && node dist/cli.js",
    "login": "node scripts/claude.mjs auth login --claudeai",
    "login-status": "node scripts/claude.mjs auth status",
    "ui-preview": "node scripts/ui-preview.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.326",
    "sherpa-onnx-node": "^2.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
